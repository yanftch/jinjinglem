page { height: 100%; overflow: hidden; background: #f5f7f9; }
.full-map-page { position: relative; width: 100%; height: 100vh; }
.full-route-map { width: 100%; height: 100%; }
.map-hint { position: absolute; top: 26rpx; left: 50%; transform: translateX(-50%); padding: 12rpx 22rpx; border-radius: 30rpx; background: rgba(255,255,255,.94); color: #59636e; font-size: 24rpx; box-shadow: 0 4rpx 18rpx rgba(30,40,50,.12); white-space: nowrap; }
.route-panel { position: absolute; right: 20rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 20rpx; padding: 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.97); box-shadow: 0 8rpx 28rpx rgba(25,35,45,.18); }
.panel-title { margin-bottom: 16rpx; color: #202830; font-size: 31rpx; font-weight: 700; }
.route-list { width: 100%; white-space: nowrap; }
.route-card { display: inline-flex; flex-direction: column; width: 300rpx; min-height: 128rpx; margin-right: 14rpx; padding: 18rpx; border: 2rpx solid #e4e9ed; border-radius: 16rpx; vertical-align: top; box-sizing: border-box; }
.route-card--active { border-color: #c7332d; background: #fffaf8; }
.route-name { display: flex; align-items: center; color: #202830; font-size: 28rpx; font-weight: 700; }
.legend-line { display: inline-block; width: 32rpx; height: 8rpx; margin-right: 10rpx; border-radius: 8rpx; }
.route-status, .route-metric { display: block; margin-top: 10rpx; color: #59636e; font-size: 24rpx; white-space: normal; }
.route-metric { color: #c7332d; font-weight: 600; }
.camera-count { display: block; margin-top: 14rpx; color: #374151; font-size: 23rpx; font-weight: 600; }
.disclaimer { display: block; margin-top: 16rpx; color: #7b858e; font-size: 22rpx; line-height: 1.5; }
