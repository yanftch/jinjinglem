<view class="route-page">
  <view wx:if="{{showMapGuide && routeOptions.length && !comparisonVisible}}" class="map-guide">点击地图，查看全屏路线图和探头位置（{{guideTimesLeft}} 次提示剩余）</view>
  <map wx:if="{{!comparisonVisible}}" id="routeMap" class="route-map {{routeOptions.length ? 'route-map--ready' : ''}}" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{12}}" markers="{{markers}}" polyline="{{polylines}}" show-location="true" bindtap="openFullMap"></map>
  <view class="route-form">
    <view class="field" bindtap="chooseStart"><text class="field-label">起点</text><text class="field-value">{{startPoint ? startPoint.name : '点击选择起点'}}</text></view>
    <view class="field" bindtap="chooseEnd"><text class="field-label">终点</text><text class="field-value">{{endPoint ? endPoint.name : '点击选择终点'}}</text></view>
    <view class="route-point-actions"><button class="subtle-button" size="mini" bindtap="swapPoints">交换起终点</button></view>
    <view class="field"><text class="field-label">持有证件</text><text class="field-value">无任何证件</text></view>
    <view class="field"><text class="field-label">路线偏好</text><picker class="field-value" range="{{preferences}}" value="{{preferenceIndex}}" bindchange="changePreference">{{preferences[preferenceIndex]}}　›</picker></view>
    <text class="planning-tip">如果规划失败，尝试拆分多段路线进行规划</text>
    <text class="camera-accuracy-tip">规划后请仔细确认路线沿线探头是否准确</text>
    <button class="plan-button {{planning ? 'plan-button--busy' : ''}}" disabled="{{planning || memberChecking}}" bindtap="plan">开始规划</button>
    <text class="status">{{statusText}}</text>
    <button wx:if="{{routeOptions.length && !comparisonVisible}}" class="subtle-button" bindtap="openComparison">查看路线对比</button>
  </view>
  <view wx:if="{{routeOptions.length}}" class="route-legend">
    <view wx:for="{{routeOptions}}" wx:key="key" class="legend-item">
      <view class="legend-line" style="background: {{item.color}}"></view>{{item.title}}
    </view>
  </view>
  <view wx:if="{{comparisonVisible}}" class="comparison-backdrop" catchtap="closeComparison">
    <view class="comparison-panel" catchtap="noop">
      <view class="comparison-header">
        <view><text class="comparison-kicker">小汽车嗒嗒嗒 · 路线对比</text><text class="comparison-title">两种路线规划结果</text></view>
        <button class="comparison-close" bindtap="closeComparison">×</button>
      </view>
      <scroll-view scroll-y class="comparison-scroll">
        <view wx:for="{{routeOptions}}" wx:key="key" class="comparison-card {{selectedRouteIndex === index ? 'comparison-card--active' : ''}}" data-index="{{index}}" bindtap="selectResult">
          <view class="comparison-card-title"><view class="legend-line" style="background: {{item.color}}"></view>{{item.title}}</view>
          <text class="comparison-status">{{item.status}}</text>
          <text wx:if="{{item.distance || item.useTime}}" class="comparison-metrics">{{item.distance}} · {{item.useTime}}</text>
          <text class="comparison-note">{{item.note}}</text>
          <view wx:if="{{selectedRouteIndex === index && item.steps.length}}" class="comparison-steps">
            <view wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="id" class="step">{{stepIndex + 1}}. {{step.instruction}}</view>
          </view>
        </view>
        <text class="comparison-footer">探头和路线信息仅供参考，实际通行请以现场道路及交通管理规定为准。</text>
      </scroll-view>
    </view>
  </view>
</view>
