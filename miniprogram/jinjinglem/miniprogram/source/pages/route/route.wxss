page { background: #f5f7f9; }
.route-page { padding-bottom: 50rpx; }
.route-map { width: 100%; height: 500rpx; }
.route-form { margin: 20rpx 24rpx; padding: 26rpx; background: #fff; border-radius: 20rpx; }
.membership-banner { padding: 16rpx; margin-bottom: 10rpx; border-radius: 12rpx; background: #fff5e9; color: #9b5a1b; font-size: 23rpx; }
.field { display: flex; align-items: center; min-height: 88rpx; border-bottom: 1rpx solid #eee; font-size: 28rpx; }
.field-label { width: 140rpx; color: #68717c; }
.field-value { flex: 1; color: #202830; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.remove { color: #c43e35; padding-left: 18rpx; }
.subtle-button { margin: 16rpx 0; color: #2563eb; background: #edf4ff; }
.route-point-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; margin: 16rpx 0; }
.route-point-actions .subtle-button { margin: 0; }
.plan-button { margin-top: 22rpx; color: #fff; background: #c7332d; }
.plan-button--busy { color: #fff; background: #a45c58; opacity: 1; }
.status { display: block; padding-top: 16rpx; color: #6b7280; font-size: 24rpx; text-align: center; }
.route-legend { display: flex; flex-wrap: wrap; gap: 20rpx; margin: 0 24rpx; color: #4b5563; font-size: 24rpx; }
.legend-item, .comparison-card-title { display: flex; align-items: center; }
.legend-line { display: inline-block; width: 32rpx; height: 8rpx; border-radius: 8rpx; margin-right: 12rpx; }
.comparison-backdrop { position: fixed; inset: 0; z-index: 1000; background: rgba(20, 30, 40, .55); display: flex; align-items: center; justify-content: center; padding: 36rpx; }
.comparison-panel { width: 100%; max-height: 78vh; background: #fff; border-radius: 28rpx; overflow: hidden; display: flex; flex-direction: column; }
.comparison-header { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 30rpx 20rpx; border-bottom: 1rpx solid #edf0f2; }
.comparison-kicker { display: block; color: #c7332d; font-size: 22rpx; }
.comparison-title { display: block; margin-top: 6rpx; color: #202830; font-size: 34rpx; font-weight: 700; }
.comparison-close { margin: 0; width: 60rpx; height: 60rpx; padding: 0; line-height: 54rpx; color: #64717b; background: #f2f4f5; border-radius: 14rpx; font-size: 42rpx; }
.comparison-scroll { height: 60vh; }
.comparison-card { margin: 20rpx 26rpx; padding: 24rpx; border: 2rpx solid #e4e9ed; border-radius: 20rpx; }
.comparison-card--active { border-color: #c7332d; background: #fffaf8; }
.comparison-card-title { color: #202830; font-size: 30rpx; font-weight: 700; }
.comparison-status, .comparison-metrics, .comparison-note { display: block; margin-top: 12rpx; }
.comparison-status { color: #374151; font-size: 26rpx; }
.comparison-metrics { color: #c7332d; font-size: 27rpx; font-weight: 600; }
.comparison-note, .comparison-footer { color: #75818c; font-size: 22rpx; line-height: 1.5; }
.comparison-steps { margin-top: 20rpx; }
.step { padding: 14rpx 0; border-top: 1rpx solid #e9edef; color: #313b49; font-size: 24rpx; }
.comparison-footer { display: block; padding: 0 30rpx 30rpx; }
