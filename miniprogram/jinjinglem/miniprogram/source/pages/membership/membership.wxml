<view class="page">
  <view class="hero"><text class="eyebrow">小汽车嗒嗒嗒 · 会员服务</text><text class="title">让每一次出行更从容</text><text class="description">新用户首次注册赠送 99 年会员，所有功能均可免费使用。</text></view>
  <view class="card"><text class="section">我的权益</text><view class="member-number"><view class="member-number-info"><text class="member-number-label">会员编号</text><text class="member-number-value">{{memberNumber || '正在获取…'}}</text></view><button class="copy-number" disabled="{{!memberNumber}}" bindtap="copyMemberId">复制</button></view><text class="member-number-hint">联系客服查询或开通会员时，请提供此编号。</text><text class="value">{{loading ? '正在查询…' : active ? '权益有效' : '未开通 / 已到期'}}</text><text class="sub">有效期至 {{expiresAt}}</text><text wx:if="{{hasTrial && !hasWelcome}}" class="sub">试用期至 {{trialExpiresAt}}</text><text wx:if="{{error}}" class="error">{{error}}</text></view>
  <view class="card"><text class="section">最近订单</text><view wx:for="{{orders}}" wx:key="id" class="order"><text>{{item.planText}} · {{item.statusText}}</text><text class="sub">{{item.createdText}}　{{item.out_trade_no}}</text></view><text wx:if="{{!orders.length}}" class="sub">暂无订单</text></view>
</view>
