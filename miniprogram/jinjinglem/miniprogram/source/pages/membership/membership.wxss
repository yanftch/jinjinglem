page { background:#faf7f3; color:#252b30; }
.page { padding:28rpx; padding-bottom:70rpx; }
.hero { padding:38rpx; border-radius:26rpx; background:#bd342f; color:white; }
.eyebrow,.title,.description,.section,.value,.sub,.notice,.code,.error,.plan-title { display:block; }
.eyebrow { font-size:22rpx; color:#ffe2ce; }.title { margin-top:18rpx; font-size:38rpx; font-weight:700; }.description { margin-top:20rpx; line-height:1.6; font-size:24rpx; }
.card { margin-top:24rpx; padding:28rpx; border:1rpx solid #eee3dc; border-radius:22rpx; background:white; }
.section { font-size:29rpx; font-weight:700; }.value { margin-top:20rpx; font-size:30rpx; color:#bb342e; font-weight:700; }.sub { margin-top:10rpx; color:#777e84; font-size:22rpx; line-height:1.5; }.error { margin-top:15rpx; color:#c7332d; }
.plan { display:flex; justify-content:space-between; align-items:center; border-bottom:1rpx solid #eee; padding:20rpx 0; }.plan-title { font-size:27rpx; font-weight:600; }.plan button { margin:0; padding:0 20rpx; font-size:24rpx; color:white; }.purchase-unavailable { background:#aaa; }.notice { margin-top:18rpx; color:#99765b; font-size:21rpx; line-height:1.5; }.outline { margin-top:18rpx; background:#fff; border:1rpx solid #bd342f; color:#bd342f; font-size:25rpx; }.code { margin-top:14rpx; text-align:center; font-size:36rpx; letter-spacing:3rpx; font-weight:700; }.order { padding:16rpx 0; border-bottom:1rpx solid #eee; font-size:24rpx; }
