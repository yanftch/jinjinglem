page { background:#faf7f3; color:#252b30; }
.page { padding:28rpx; padding-bottom:70rpx; }
.hero { padding:38rpx; border-radius:26rpx; background:#bd342f; color:white; }
.eyebrow,.title,.description,.section,.value,.sub,.notice,.code,.error,.plan-title { display:block; }
.eyebrow { font-size:26rpx; color:#ffe2ce; }.title { margin-top:18rpx; font-size:42rpx; font-weight:700; }.description { margin-top:20rpx; line-height:1.6; font-size:28rpx; }
.card { margin-top:24rpx; padding:28rpx; border:1rpx solid #eee3dc; border-radius:22rpx; background:white; }
.section { font-size:33rpx; font-weight:700; }.value { margin-top:20rpx; font-size:34rpx; color:#bb342e; font-weight:700; }.sub { margin-top:10rpx; color:#777e84; font-size:26rpx; line-height:1.5; }.error { margin-top:15rpx; color:#c7332d; }
.member-number { display:flex; align-items:center; justify-content:space-between; margin-top:18rpx; padding:18rpx 20rpx; border-radius:14rpx; background:#f7f4f1; }.member-number-info { min-width:0; }.member-number-label,.member-number-value { display:block; }.member-number-label { color:#777e84; font-size:25rpx; }.member-number-value { margin-top:6rpx; color:#252b30; font-size:31rpx; font-weight:700; letter-spacing:1rpx; }.copy-number { flex:none; margin:0 0 0 16rpx; padding:0 20rpx; color:#bd342f; background:#fff; border:1rpx solid #e9d8d1; font-size:26rpx; }.member-number-hint { display:block; margin-top:10rpx; color:#99765b; font-size:25rpx; line-height:1.5; }
.plan { display:flex; justify-content:space-between; align-items:center; border-bottom:1rpx solid #eee; padding:20rpx 0; }.plan-title { font-size:31rpx; font-weight:600; }.plan button { margin:0; padding:0 20rpx; font-size:28rpx; color:white; }.purchase-unavailable { background:#aaa; }.notice { margin-top:18rpx; color:#99765b; font-size:25rpx; line-height:1.5; }.outline { margin-top:18rpx; background:#fff; border:1rpx solid #bd342f; color:#bd342f; font-size:29rpx; }.code { margin-top:14rpx; text-align:center; font-size:40rpx; letter-spacing:3rpx; font-weight:700; }.order { padding:16rpx 0; border-bottom:1rpx solid #eee; font-size:28rpx; }
