page { background: #f4f6f7; }
.place-page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
.map-area { position: relative; flex: 0 0 47%; min-height: 0; }
.place-map { width: 100%; height: 100%; }
.locate-button { position: absolute; left: 24rpx; bottom: 24rpx; width: 82rpx; height: 82rpx; margin: 0; padding: 0; border-radius: 16rpx; background: #fff; color: #263b45; font-size: 48rpx; line-height: 78rpx; box-shadow: 0 6rpx 24rpx #263b4526; }
.map-point-button { position: absolute; right: 24rpx; bottom: 24rpx; margin: 0; padding: 0 25rpx; border-radius: 45rpx; background: #c7332d; color: #fff; font-size: 25rpx; box-shadow: 0 6rpx 24rpx #263b4526; }
.place-panel { position: relative; z-index: 1; display: flex; flex-direction: column; flex: 1; min-height: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.search-row { padding: 26rpx 24rpx 12rpx; }
.search-box { display: flex; align-items: center; height: 82rpx; padding: 0 20rpx; border-radius: 14rpx; background: #f1f3f5; }
.search-icon { color: #85919a; font-size: 40rpx; line-height: 1; margin-right: 14rpx; }
.search-input { flex: 1; height: 82rpx; min-width: 0; color: #202830; font-size: 29rpx; }
.clear-search { padding: 0 8rpx; color: #87939c; font-size: 38rpx; }
.place-list { flex: 1; min-height: 0; height: 0; }
.section-title { display: block; padding: 12rpx 28rpx; color: #8b979e; font-size: 23rpx; }
.list-message { display: block; padding: 60rpx 30rpx; color: #8b979e; font-size: 25rpx; text-align: center; }
.place-item { padding: 25rpx 28rpx; border-bottom: 1rpx solid #eef0f2; }
.place-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #202830; font-size: 29rpx; }
.place-address { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 8rpx; color: #9ba5ab; font-size: 23rpx; }
