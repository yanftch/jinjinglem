page { min-height: 100%; background: #f7f3ef; color: #292b30; }
.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx; padding-bottom: 56rpx; }
.hero { padding: 36rpx; border-radius: 26rpx; background: linear-gradient(145deg, #a72f2b, #cf4c3c); color: #fffaf5; }
.eyebrow, .title, .intro, .section-title, .body { display: block; }
.eyebrow { color: #ffe3d7; font-size: 25rpx; }
.title { margin-top: 16rpx; font-size: 42rpx; font-weight: 700; }
.intro { margin-top: 16rpx; color: #fff0e9; font-size: 27rpx; line-height: 1.65; }
.card { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid #e9e4df; border-radius: 22rpx; background: #fff; }
.section-title { margin-bottom: 18rpx; font-size: 31rpx; font-weight: 700; }
.legend { display: flex; align-items: center; min-height: 54rpx; color: #60666c; font-size: 27rpx; }
.dot { width: 20rpx; height: 20rpx; margin-right: 16rpx; border-radius: 50%; }
.dot-inner { background: #e34c42; }.dot-outer { background: #438bd1; }.dot-second { background: #9a67bb; }.dot-discard { background: #e4b43f; }
.body { color: #60666c; font-size: 27rpx; line-height: 1.75; }.secondary { margin-top: 16rpx; color: #9a7566; }
.footer { margin-top: 30rpx; color: #a49b95; font-size: 22rpx; text-align: center; }
