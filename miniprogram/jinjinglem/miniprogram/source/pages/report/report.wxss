page{background:#fffaf5}
.report-page{padding:26rpx 28rpx 70rpx;color:#292b30}
.hero{display:flex;flex-direction:column;padding:36rpx;border-radius:26rpx;background:#bd342f;color:#fff;box-shadow:0 15rpx 30rpx #bd342f28}
.hero-kicker{color:#f3d6c2;font-size:26rpx;letter-spacing:3rpx}.hero-title{margin-top:14rpx;font-size:47rpx;font-weight:800}.hero-copy{margin-top:16rpx;color:#ffe8dc;font-size:29rpx;line-height:1.6}
.report-card{margin-top:26rpx;padding:32rpx;border:1rpx solid #efe3da;border-radius:24rpx;background:#fff}
.step-title{display:flex;align-items:center;gap:14rpx;margin:30rpx 0 17rpx;font-size:31rpx;font-weight:700}.step-title:first-child{margin-top:0}
.step-number{display:flex;align-items:center;justify-content:center;width:45rpx;height:45rpx;border-radius:50%;background:#fae8e4;color:#bd342f;font-size:23rpx}
.required{margin-left:auto;color:#a89a90;font-size:24rpx;font-weight:400}
.nickname-input,.content-input{box-sizing:border-box;width:100%;border:1rpx solid #e5d8cf;border-radius:14rpx;background:#fffdfb;font-size:30rpx}
.nickname-input{height:86rpx;padding:0 20rpx}.content-input{height:260rpx;padding:20rpx;line-height:1.5}
.upload-box{display:flex;align-items:center;justify-content:center;flex-direction:column;min-height:230rpx;border:2rpx dashed #dfc7bc;border-radius:17rpx;background:#fffbf8;color:#8d7065;font-size:28rpx}
.upload-icon{font-size:62rpx;line-height:1}.upload-hint{margin-top:10rpx;color:#aa9a92;font-size:24rpx}
.preview-box{border:1rpx solid #ece2dc;border-radius:17rpx;overflow:hidden}.preview-image{display:block;width:100%;height:300rpx;background:#f8f6f5}.preview-actions{display:flex;justify-content:flex-end;gap:36rpx;padding:18rpx 24rpx;color:#bd342f;font-size:28rpx}
.count{display:block;margin-top:9rpx;color:#ac9e97;font-size:24rpx;text-align:right}.submit-button{margin-top:35rpx;background:#bd342f;color:white;border-radius:15rpx;font-size:33rpx;font-weight:700}.submit-button[disabled]{opacity:.6}
.footnote{margin-top:20rpx;color:#a49a95;font-size:25rpx;text-align:center;line-height:1.6}
