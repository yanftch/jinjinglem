<view class="page">
  <map id="myMap" class="map-container" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{mode === 'LIVE' ? markers : reviewMarkers}}" show-location="{{mode === 'LIVE'}}" bindregionchange="onRegionChange" bindcallouttap="onMarkerTap" bindmarkertap="onMarkerTap" bindtap="onMapTap">
    <cover-view wx:if="{{mode === 'LIVE'}}" class="bottom-actions">
      <cover-view class="bottom-action route-action" bindtap="routePlan">路线导航</cover-view>
      <cover-view class="bottom-action" bindtap="openProfile">我的</cover-view>
    </cover-view>
    <cover-view wx:if="{{mode === 'LIVE' || mode === 'REVIEW'}}" class="locate-action {{mode === 'REVIEW' ? 'review-locate-action' : ''}}" bindtap="onLocateTap">{{mode === 'REVIEW' ? '到达' : '◎'}}</cover-view>
  </map>
  <view wx:if="{{mode === 'LIVE'}}" class="search-container">
    <view class="search-box">
      <text class="search-glyph">⌕</text>
      <input class="search-input" bindfocus="onSearchFocus" bindblur="onSearchBlur" bindinput="onSearchInput" confirm-type="search" placeholder="搜索探头" value="{{searchKeyword}}"></input>
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">×</text>
    </view>
    <text wx:if="{{isSearchFocused}}" class="search-cancel" bindtap="cancelSearch">取消</text>
  </view>
  <scroll-view wx:if="{{mode === 'LIVE' && searchResults.length > 0 && searchKeyword}}" scroll-y="true" class="search-results">
    <view wx:for="{{searchResults}}" wx:key="id" class="search-result-item" data-item="{{item}}" bindtap="onSearchResultTap">
      <view class="result-icon"><image class="result-icon-img" mode="aspectFit" src="{{item.iconPath}}"></image></view>
      <view class="result-info"><text class="result-name">{{item.name}}</text><text class="result-type">{{item.typeText}}</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{mode === 'LIVE' && searchKeyword && !searchResults.length && !isSearching}}" class="search-no-result">未找到相关探头</view>
  <view wx:if="{{mode === 'LIVE' && showNewCameras}}" class="updates-mask" bindtap="closeNewCameras">
    <view class="updates-card" catchtap="stopNewCamerasTap">
      <view class="updates-head">
        <image class="updates-logo" src="/image/brand.png" mode="aspectFit"></image>
        <view class="updates-heading"><text class="updates-eyebrow">小汽车嗒嗒嗒 · 更新播报</text><text class="updates-title">最近新增的探头</text></view>
        <text class="updates-close" bindtap="closeNewCameras">×</text>
      </view>
      <view class="updates-intro">为你整理最近 7 天新增并收录的探头点位，点选记录可查看详情。</view>
      <scroll-view class="updates-list" scroll-y="true" style="height: {{newCameraListHeight}}rpx;">
        <view class="updates-item" wx:for="{{newCameras}}" wx:key="id" data-id="{{item.id}}" bindtap="openNewCamera">
          <text class="updates-number">{{item.number}}</text>
          <view class="updates-item-body"><text class="updates-name">{{item.name}}</text><view class="updates-meta"><text class="updates-type">{{item.typeText}}</text><text>收录 {{item.createdAtText}}</text></view></view>
          <text class="updates-arrow">›</text>
        </view>
      </scroll-view>
      <button class="updates-action" bindtap="closeNewCameras">查看地图</button>
    </view>
  </view>
</view>
