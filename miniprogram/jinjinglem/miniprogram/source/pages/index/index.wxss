page, .page {
  width: 100%;
  height: 100%;
}

.map-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.search-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: calc(16rpx + env(safe-area-inset-top)) 24rpx 16rpx;
  pointer-events: none;
}

.search-box {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 14rpx 24rpx;
  background: rgba(255,255,255,.95);
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.15);
  pointer-events: auto;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  color: #333;
  font-size: 28rpx;
}

.search-glyph { color: #666; font-size: 38rpx; line-height: 38rpx; }
.search-clear { color: #999; font-size: 38rpx; padding: 0 4rpx; }

.search-cancel {
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,.95);
  border-radius: 20rpx;
  color: #39f;
  font-size: 28rpx;
  pointer-events: auto;
}

.search-results, .search-no-result {
  position: fixed;
  top: calc(100rpx + env(safe-area-inset-top));
  left: 24rpx;
  right: 24rpx;
  z-index: 99;
  background: rgba(255,255,255,.97);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.15);
}

.search-results { max-height: 55vh; }
.search-no-result { padding: 48rpx 0; text-align: center; color: #999; font-size: 28rpx; }
.search-result-item { display: flex; align-items: center; padding: 20rpx 28rpx; border-bottom: 1rpx solid #eee; }
.result-icon { width: 60rpx; margin-right: 20rpx; }
.result-icon-img { width: 40rpx; height: 60rpx; }
.result-info { display: flex; flex: 1; flex-direction: column; }
.result-name { color: #333; font-size: 28rpx; }
.result-type { color: #999; font-size: 24rpx; margin-top: 4rpx; }

.bottom-actions {
  position: fixed;
  bottom: 52rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
}

.bottom-action {
  box-sizing: border-box;
  width: 48%;
  padding: 18rpx 0;
  border-radius: 36rpx;
  background: rgba(255,255,255,.94);
  color: #303640;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.route-action { background: #c7332d; color: #fff; }

.locate-action {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255,255,255,.95);
  color: #0052d9;
  font-size: 44rpx;
}

.review-locate-action {
  bottom: 64rpx;
  width: 96rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.updates-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx;
  background: rgba(28, 25, 24, .62);
}

.updates-card {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  max-height: 78vh;
  overflow: hidden;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 30rpx;
  background: #fffaf5;
  box-shadow: 0 24rpx 70rpx rgba(25, 15, 13, .25);
}

.updates-head { display: flex; align-items: center; }
.updates-logo { width: 82rpx; height: 82rpx; border-radius: 20rpx; flex: none; }
.updates-heading { flex: 1; min-width: 0; margin-left: 20rpx; }
.updates-eyebrow { display: block; color: #b95a4b; font-size: 21rpx; letter-spacing: 2rpx; }
.updates-title { display: block; margin-top: 3rpx; color: #292b30; font-size: 35rpx; font-weight: 700; }
.updates-close { padding: 4rpx 8rpx 10rpx 18rpx; color: #8c817c; font-size: 48rpx; line-height: 1; }
.updates-intro { margin: 24rpx 0 18rpx; color: #857b76; font-size: 23rpx; line-height: 1.5; }
.updates-list { max-height: 45vh; border-top: 1rpx solid #ebdfd7; border-bottom: 1rpx solid #ebdfd7; }
.updates-item { display: flex; align-items: center; box-sizing: border-box; min-height: 112rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f1e8e1; }
.updates-item:last-child { border-bottom: 0; }
.updates-number { width: 54rpx; flex: none; color: #cf7b65; font-size: 30rpx; font-weight: 700; }
.updates-item-body { flex: 1; min-width: 0; }
.updates-name { display: block; color: #35343a; font-size: 26rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.updates-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 9rpx; color: #a19891; font-size: 20rpx; }
.updates-type { padding: 4rpx 10rpx; border-radius: 6rpx; background: #f5e5dd; color: #a8493e; font-weight: 700; }
.updates-arrow { margin-left: 10rpx; color: #be7363; font-size: 42rpx; }
.updates-action { margin-top: 28rpx; border: 0; border-radius: 14rpx; background: #bd342f; color: #fff; font-size: 28rpx; font-weight: 700; }
