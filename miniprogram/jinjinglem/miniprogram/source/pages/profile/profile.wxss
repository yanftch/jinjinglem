page { background: #fffaf5; }
.profile-page { box-sizing: border-box; min-height: 100vh; padding: 24rpx 28rpx 64rpx; color: #292b30; }
.hero-card { position: relative; overflow: hidden; padding: 32rpx; border-radius: 28rpx; background: #bd342f; color: #fffaf5; box-shadow: 0 14rpx 30rpx rgba(145, 38, 33, .17); }
.hero-card::after { position: absolute; right: -80rpx; bottom: -172rpx; width: 360rpx; height: 360rpx; border: 1rpx solid rgba(255,255,255,.24); border-radius: 50%; content: ""; }
.hero-top, .identity-row { display: flex; align-items: center; }
.hero-top { justify-content: space-between; }
.hero-kicker { font-size: 22rpx; letter-spacing: 2rpx; color: #ffe5d4; }
.hero-seal { font-size: 30rpx; color: #f4c96c; }
.identity-row { position: relative; z-index: 1; margin-top: 38rpx; }
.avatar { width: 98rpx; height: 98rpx; flex: none; border: 4rpx solid rgba(255,255,255,.8); border-radius: 25rpx; }
.identity-text { min-width: 0; margin-left: 22rpx; }
.greeting { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 34rpx; font-weight: 700; }
.identity-note { display: block; margin-top: 9rpx; color: #f9dbd3; font-size: 22rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 38rpx 4rpx 18rpx; font-size: 30rpx; font-weight: 700; }
.service-card { overflow: hidden; border: 1rpx solid #f0e4dc; border-radius: 22rpx; background: #fff; }
.service-row { display: flex; align-items: center; min-height: 112rpx; margin: 0 24rpx; border-bottom: 1rpx solid #f2eae5; }
.service-row-last { border-bottom: 0; }
.service-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; flex: none; margin-right: 20rpx; border-radius: 15rpx; font-size: 29rpx; font-weight: 700; }
.help-icon { background: #e9f2ea; color: #4f9064; }
.member-icon { background: #fbf0da; color: #ad8135; }
.app-icon { background: #f1ebf8; color: #896da8; }
.limit-icon { background: #f9eee4; color: #b78249; }
.service-icon-muted { background: #f2eeec; color: #827b79; }
.about-icon { background: #f9e6e2; color: #bd342f; }
.service-text { display: flex; flex: 1; flex-direction: column; min-width: 0; font-size: 26rpx; font-weight: 600; }
.service-name { display: block; }
.service-caption { display: block; margin-top: 6rpx; color: #a39790; font-size: 21rpx; font-weight: 400; }
.service-arrow { color: #b3a6a0; font-size: 40rpx; }
.pending-tag { padding: 7rpx 11rpx; border-radius: 8rpx; background: #f5f2f0; color: #928882; font-size: 19rpx; }
.share-button { margin-top: 32rpx; border: 1rpx solid #edddd4; border-radius: 16rpx; background: #fff; color: #b4473c; font-size: 27rpx; font-weight: 700; }
.footnote { margin: 28rpx 12rpx 0; color: #ac9e95; font-size: 20rpx; text-align: center; line-height: 1.5; }
