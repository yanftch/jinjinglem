<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="22sp" />
        <Button android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="修改昵称" />
        <TextView android:id="@+id/memberStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="正在查询设备会员状态…" />
        <Button android:id="@+id/member" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="会员服务" />
        <Button android:id="@+id/openMembership" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开通会员" />
        <Button android:id="@+id/contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="联系客服" />
        <Button android:id="@+id/route" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="规划路线" />
        <Button android:id="@+id/report" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="上报新增探头" />
        <Button android:id="@+id/traffic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="限行说明" />
        <Button android:id="@+id/permit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="进京证（暂不可用）" android:enabled="false" />
        <Button android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="实时导航（暂不可用）" android:enabled="false" />
        <Button android:id="@+id/help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="使用说明" />
        <Button android:id="@+id/about" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关于进京了" />
        <Button android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="分享进京了" />
    </LinearLayout>
</ScrollView>
