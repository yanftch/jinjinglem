<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="会员服务" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="请使用小程序生成 App 登录动态码" android:textSize="17sp" android:padding="12dp" />
        <EditText android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="输入小程序生成的 10 分钟动态码" android:singleLine="true" />
        <Button android:id="@+id/login" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="登录现有会员账号" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="刷新会员状态" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="订单记录" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/orders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="月会员 10 元 · 年会员 108 元。Android 支付方式待确认，购买请先使用小程序（如已开通）。" android:textColor="@color/muted" />
        <Button android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="退出登录" />
    </LinearLayout>
</ScrollView>
