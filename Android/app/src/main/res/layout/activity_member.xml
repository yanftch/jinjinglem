<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="会员服务" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="无需注册或登录。设备会自动登记，管理员可按月或按年开通会员。" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="正在查询设备会员状态…" android:textSize="18sp" android:padding="12dp" />
        <TextView android:id="@+id/deviceId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textIsSelectable="true" android:breakStrategy="simple" android:textSize="13sp" android:textColor="@color/muted" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="刷新会员状态" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="路线规划需要有效会员，每次规划前都会重新查询服务端会员身份。" android:textColor="@color/muted" />
    </LinearLayout>
</ScrollView>
